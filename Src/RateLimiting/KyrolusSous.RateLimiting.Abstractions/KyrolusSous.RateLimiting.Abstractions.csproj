<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Core contracts, interfaces, and metadata abstractions for Kyrolus high-performance ASP.NET Core rate limiting and partitioned throttling.</Description>
    <PackageTags>$(PackageTags);ratelimiting;throttling;partitioning;abstractions;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
