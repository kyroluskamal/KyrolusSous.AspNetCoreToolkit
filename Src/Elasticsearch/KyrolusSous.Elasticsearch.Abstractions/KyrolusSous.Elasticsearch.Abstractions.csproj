<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>KyrolusSous.Elasticsearch</RootNamespace>
    <Description>Pure abstractions, models, attributes, and repository contracts for Kyrolus Elasticsearch search engines.</Description>
    <PackageTags>elasticsearch;search;abstractions;repository;contracts;models</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.17.0" />
  </ItemGroup>

</Project>
