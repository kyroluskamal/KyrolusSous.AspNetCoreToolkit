<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>KyrolusSous.Compression</RootNamespace>
    <AssemblyName>KyrolusSous.Compression.Zstd</AssemblyName>
    <Description>Meta's Zstandard (Zstd) compression algorithm provider for the Kyrolus compression ecosystem.</Description>
    <Authors>Kyrolus Sous</Authors>
    <PackageTags>compression;zstd;zstandard;meta;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyrolusSous.Compression.Abstractions\KyrolusSous.Compression.Abstractions.csproj" />
    <ProjectReference Include="..\KyrolusSous.Compression.Core\KyrolusSous.Compression.Core.csproj" />
  </ItemGroup>

</Project>
