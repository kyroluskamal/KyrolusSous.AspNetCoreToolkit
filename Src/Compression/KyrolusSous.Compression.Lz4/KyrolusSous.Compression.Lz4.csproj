<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>KyrolusSous.Compression</RootNamespace>
    <AssemblyName>KyrolusSous.Compression.Lz4</AssemblyName>
    <Description>Ultra-fast LZ4 compression algorithm provider for the Kyrolus compression ecosystem.</Description>
    <Authors>Kyrolus Sous</Authors>
    <PackageTags>compression;lz4;fast;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyrolusSous.Compression.Abstractions\KyrolusSous.Compression.Abstractions.csproj" />
    <ProjectReference Include="..\KyrolusSous.Compression.Core\KyrolusSous.Compression.Core.csproj" />
  </ItemGroup>

</Project>
