<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Standardized payment abstractions and unified models for multi-gateway payment processing across Global, Europe, US, and MENA.</Description>
    <PackageTags>$(PackageTags);payments;gateway;stripe;paypal;paymob;fawry;adyen;abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
