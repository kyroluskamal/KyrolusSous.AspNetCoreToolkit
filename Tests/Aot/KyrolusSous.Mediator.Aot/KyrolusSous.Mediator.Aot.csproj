<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exists to be published with NativeAOT. The Roslyn analyzers on the runtime project catch a
    MakeGenericType in the library's own source, but only ILC sees the whole program - including
    the generic instantiations the dependency injection container closes on the library's behalf.
    Publishing this is the only check that answers the question end to end.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One warning per problem. The default collapses them to one per assembly, which hides
         exactly the detail this project exists to surface. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Src\KyrolusSous.Mediator.Abstractions\KyrolusSous.Mediator.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Src\KyrolusSous.Mediator.Runtime\KyrolusSous.Mediator.Runtime.csproj" />
    <ProjectReference Include="..\..\..\Src\KyrolusSous.Mediator.Generator\KyrolusSous.Mediator.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
